{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/trades",
      "destination": "/trades/index.html"
    },
    {
      "source": "/trades/(.*)",
      "destination": "/trades/index.html"
    },
    {
      "source": "/portal/app",
      "destination": "/portal/app/index.html"
    },
    {
      "source": "/portal/app/(.*)",
      "destination": "/portal/app/index.html"
    },
    {
      "source": "/portal/collection-letter",
      "destination": "/portal/collection-letter/index.html"
    },
    {
      "source": "/portal/payroll",
      "destination": "/portal/payroll/index.html"
    },
    {
      "source": "/portal/invoices",
      "destination": "/portal/invoices/index.html"
    },
    {
      "source": "/portal/warning-letter",
      "destination": "/portal/warning-letter/index.html"
    },
    {
      "source": "/portal/business-letter",
      "destination": "/portal/business-letter/index.html"
    },
    {
      "source": "/portal/signup",
      "destination": "/portal/signup/index.html"
    },
    {
      "source": "/portal/pricing",
      "destination": "/portal/pricing/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/paddle-webhook.js": {
      "maxDuration": 60
    },
    "api/send-full-report.js": {
      "maxDuration": 60
    },
    "api/send-diagnostic.js": {
      "maxDuration": 30
    },
    "api/send-checkin.js": {
      "maxDuration": 15
    },
    "api/send-plan.js": {
      "maxDuration": 60
    },
    "api/generate-checklist.js": {
      "maxDuration": 30
    },
    "api/deskkit-charge.js": {
      "maxDuration": 30
    },
    "api/deskkit-save.js": {
      "maxDuration": 15
    },
    "api/deskkit-tasks.js": {
      "maxDuration": 15
    },
    "api/portal-reset.js": {
      "maxDuration": 15
    },
    "api/portal-signup.js": {
      "maxDuration": 15
    }
  },
  "env": {
    "SITE_URL": "https://www.compassbizsolutions.com"
  }
}